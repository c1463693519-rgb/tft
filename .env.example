# Copy to `.env` for local development. Never commit `.env`.
# NOTE: Do NOT put Mechanics numbers (stats, formulas, caps) in env vars — see docs/DEPLOYMENT.md §4.
# All values below are server-side only. Never expose them via NEXT_PUBLIC_* variables.

# PostgreSQL and Redis run on the project VPS and are reached directly via <vps-ip>:<port>
# with TLS (docs/DECISIONS.md ADR-011, docs/SECURITY_COMPLIANCE.md §9). Nothing is installed locally.
# Use a dev-only database and account here — never the prod credentials.

# PostgreSQL — normalized game data, rules, patch revisions
DATABASE_URL=postgres://<dev_user>:<password>@<vps-ip>:<port>/tft_dev?sslmode=require

# PostgreSQL test database for integration tests (CI gets its own value from GitHub Secrets)
TEST_DATABASE_URL=postgres://<test_user>:<password>@<vps-ip>:<port>/tft_test?sslmode=require

# Redis — cache / rate limiting (optional initially). ACL user + password and TLS (rediss://) required.
REDIS_URL=rediss://<dev_user>:<password>@<vps-ip>:<port>/0

# ClickHouse — match analytics (Meta phase only; hosting not decided)
CLICKHOUSE_URL=http://localhost:8123

# Object storage — raw source snapshots (early phases use a local directory; hosting not decided)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=tft-raw
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Riot API key — server/worker only, never in the browser bundle, never logged in full.
# Not used yet (Riot Match pipeline is Phase 8).
RIOT_API_KEY=

# Explicit patch revision the app serves (must reference a stored revision, e.g. 18.3-B.1)
ACTIVE_PATCH_REVISION=
