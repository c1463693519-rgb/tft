# Copy to `.env` for local development. Never commit `.env`.
# NOTE: Do NOT put Mechanics numbers (stats, formulas, caps) in env vars — see docs/DEPLOYMENT.md §4.
# All values below are server-side only. Never expose them via NEXT_PUBLIC_* variables.

# PostgreSQL — normalized game data, rules, patch revisions
DATABASE_URL=postgres://tft:tft@localhost:5432/tft

# Redis — cache / rate limiting (optional initially)
REDIS_URL=redis://localhost:6379

# ClickHouse — match analytics (Meta phase only)
CLICKHOUSE_URL=http://localhost:8123

# Object storage — raw source snapshots (S3 / R2 / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=tft-raw
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Riot API key — server/worker only, never in the browser bundle, never logged in full.
# Not used yet (Riot Match pipeline is Phase 8).
RIOT_API_KEY=

# Explicit patch revision the app serves (must reference a stored revision, e.g. 18.3-B.1)
ACTIVE_PATCH_REVISION=
