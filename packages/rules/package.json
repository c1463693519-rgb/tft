{
  "name": "@tft/rules",
  "version": "0.0.0",
  "private": true,
  "description": "Patch-aware rules and loaders: patch revision -> mechanics runtime config.",
  "type": "module",
  "exports": {
    ".": {
      "@tft/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tft/game-schema": "workspace:*",
    "@tft/mechanics": "workspace:*",
    "@tft/shared": "workspace:*"
  }
}
